# Copy to .env.local (and add the same values in your hosting provider's environment settings).
# Website inquiries are sent through the company's Zoho Mail account.

# Zoho SMTP server — use smtp.zoho.in / smtp.zoho.eu if you log in at mail.zoho.in / mail.zoho.eu
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465

# Mailbox the website sends from (emails show as "Talent Bridge Website <this address>")
SMTP_USER=hello@talentbridge.lk

# Zoho app-specific password: Zoho Accounts → Security → App Passwords → Generate
SMTP_PASS=

# Optional display name for the sender
SMTP_FROM_NAME="Talent Bridge Website"
