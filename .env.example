# Copy to .env.local (and add the same values in your hosting provider's environment settings).

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on inquiry emails. The domain must be verified in Resend (Domains → Add talentbridge.lk).
INQUIRY_FROM_EMAIL="Talent Bridge Website <website@talentbridge.lk>"
